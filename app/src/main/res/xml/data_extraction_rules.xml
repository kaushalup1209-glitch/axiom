<?xml version="1.0" encoding="utf-8"?>
<!-- ===== SECTION: DATA_EXTRACTION_RULES =====
     Android 12+ backup rules. Only appearance preferences exist in Phase 01.
     Revisit when study data (Room) is introduced so private data is handled deliberately. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/axiom_appearance.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/axiom_appearance.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
<!-- ===== END SECTION: DATA_EXTRACTION_RULES ===== -->
